{"id": "nw-01", "contract": "northwind_master_services_agreement.txt", "question": "What is the monthly subscription fee?", "reference_answer": "EUR 18,500 per month, invoiced monthly in advance.", "reference_quote": "platform subscription fee of EUR 18,500 per month", "term": "recurring_fee", "tags": ["financial"]}
{"id": "nw-02", "contract": "northwind_master_services_agreement.txt", "question": "What is the daily rate for professional services?", "reference_answer": "EUR 1,250 per consultant day, invoiced monthly in arrears against approved timesheets.", "reference_quote": "daily rate of EUR 1,250 per consultant day", "tags": ["financial"]}
{"id": "nw-03", "contract": "northwind_master_services_agreement.txt", "question": "When are invoices due?", "reference_answer": "Within thirty (30) days of the invoice date, by bank transfer.", "reference_quote": "payable within thirty (30) days of the invoice date", "term": "payment_deadline", "tags": ["financial"]}
{"id": "nw-04", "contract": "northwind_master_services_agreement.txt", "question": "What interest applies to late payments?", "reference_answer": "1.5% per month (18% per annum), or the maximum lawful rate if lower, from the due date until paid; Customer also reimburses reasonable collection costs.", "reference_quote": "accrue interest at the rate of 1.5% per month", "term": "late_payment", "tags": ["financial"]}
{"id": "nw-05", "contract": "northwind_master_services_agreement.txt", "question": "Can the vendor suspend the services for late payment?", "reference_answer": "Yes: if an undisputed invoice is unpaid more than 60 days after its due date, Vendor may suspend the Services on ten business days' written notice until overdue amounts are paid.", "reference_quote": "Vendor may suspend the Services on ten (10) business days' written notice", "tags": ["financial"]}
{"id": "nw-06", "contract": "northwind_master_services_agreement.txt", "question": "By how much can the subscription fee be increased each year?", "reference_answer": "Once per calendar year, on at least 90 days' notice, by no more than the greater of 3% or the annual change in the Swedish consumer price index.", "reference_quote": "by no more than the greater of 3% or the annual change in the Swedish consumer price index", "term": "price_changes", "tags": ["financial"]}
{"id": "nw-07", "contract": "northwind_master_services_agreement.txt", "question": "How long does the customer have to dispute an invoice?", "reference_answer": "Fifteen (15) days from the invoice date, in writing with reasons, while paying the undisputed portion.", "reference_quote": "within fifteen (15) days of the invoice date", "tags": ["financial"]}
{"id": "nw-08", "contract": "northwind_master_services_agreement.txt", "question": "What is the early termination fee?", "reference_answer": "Fifty percent (50%) of the Subscription Fees that would otherwise have been payable for the remainder of the Initial Term; termination for convenience is only possible after the first 12 months on 90 days' notice.", "reference_quote": "early termination fee equal to fifty percent (50%)", "term": "termination_cost", "tags": ["financial", "term"]}
{"id": "nw-09", "contract": "northwind_master_services_agreement.txt", "question": "What service credits apply if availability drops below 99%?", "reference_answer": "Below 99.0%: a credit of 15% of that month's Subscription Fee (5% below 99.9%, 30% below 95.0%). Service credits are the sole remedy, except termination if availability is below 95% in three months of a rolling twelve.", "reference_quote": "below 99.0%, a credit of 15%", "tags": ["financial"]}
{"id": "nw-10", "contract": "northwind_master_services_agreement.txt", "question": "Are the fees inclusive of VAT?", "reference_answer": "No. Fees are exclusive of value added tax and other applicable taxes, which are added to the invoice.", "reference_quote": "Fees are exclusive of value added tax", "tags": ["financial"]}
{"id": "nw-11", "contract": "northwind_master_services_agreement.txt", "question": "How long is the initial term?", "reference_answer": "Thirty-six (36) months from the Effective Date.", "reference_quote": "initial term of thirty-six (36) months", "term": "initial_term", "tags": ["term"]}
{"id": "nw-12", "contract": "northwind_master_services_agreement.txt", "question": "Does the agreement renew automatically?", "reference_answer": "Yes, for successive 12-month periods unless either party gives written notice of non-renewal at least 90 days before the end of the current term.", "reference_quote": "renews automatically for successive periods of twelve (12) months", "term": "renewal", "tags": ["term"]}
{"id": "nw-13", "contract": "northwind_master_services_agreement.txt", "question": "How much notice is needed to prevent renewal?", "reference_answer": "At least ninety (90) days' written notice before the end of the then-current term.", "reference_quote": "written notice of non-renewal at least ninety (90) days before the end", "term": "notice_period", "tags": ["term"]}
{"id": "nw-14", "contract": "northwind_master_services_agreement.txt", "question": "Is there a cap on liability?", "reference_answer": "Yes: each party's total liability is capped at the fees paid or payable in the 12 months before the claim, with carve-outs for death or personal injury, fraud, confidentiality breaches and non-excludable liability; Vendor's data-protection liability is capped at twice that amount.", "reference_quote": "shall not exceed the total fees paid or payable by Customer under this Agreement in the twelve (12) months", "tags": ["liability"]}
{"id": "nw-15", "contract": "northwind_master_services_agreement.txt", "question": "Who owns deliverables created under a statement of work?", "reference_answer": "Deliverables created specifically for Customer are assigned to Customer on payment, excluding Vendor's pre-existing materials, which are licensed under Section 6.1.", "reference_quote": "Deliverables created specifically for Customer under a SOW are assigned to Customer on payment", "tags": ["ip"]}
{"id": "nw-16", "contract": "northwind_master_services_agreement.txt", "question": "How long do confidentiality obligations last after termination?", "reference_answer": "Five (5) years after termination, and indefinitely for trade secrets.", "reference_quote": "survive for five (5) years after termination", "tags": ["confidentiality"]}
{"id": "nw-17", "contract": "northwind_master_services_agreement.txt", "question": "Is there a one-time setup or onboarding fee?", "reference_answer": "Not found in contract.", "expect_not_found": true, "term": "one_off_fee", "tags": ["financial", "not_found"]}
