{"id": "hb-01", "contract": "harbor_software_subscription.txt", "question": "What is the annual subscription fee?", "reference_answer": "EUR 96,000 per year, invoiced annually in advance on the Effective Date and each anniversary.", "reference_quote": "annual subscription fee of EUR 96,000", "term": "recurring_fee", "tags": ["financial"]}
{"id": "hb-02", "contract": "harbor_software_subscription.txt", "question": "Is there a one-time onboarding fee?", "reference_answer": "Yes, a one-time onboarding fee of EUR 12,000 invoiced on the Effective Date.", "reference_quote": "one-time onboarding fee of EUR 12,000", "term": "one_off_fee", "tags": ["financial"]}
{"id": "hb-03", "contract": "harbor_software_subscription.txt", "question": "What does an additional named user cost?", "reference_answer": "EUR 40 per user per month above 200 named users, invoiced quarterly in arrears.", "reference_quote": "EUR 40 per user per month", "tags": ["financial"]}
{"id": "hb-04", "contract": "harbor_software_subscription.txt", "question": "How many days does the customer have to pay an invoice?", "reference_answer": "Forty-five (45) days from the invoice date.", "reference_quote": "due within forty-five (45) days of the invoice date", "term": "payment_deadline", "tags": ["financial"]}
{"id": "hb-05", "contract": "harbor_software_subscription.txt", "question": "What interest is charged on overdue amounts?", "reference_answer": "One percent (1%) per month from the due date until payment; access may be suspended if an invoice is unpaid 30 days after a written reminder.", "reference_quote": "interest at one percent (1%) per month", "term": "late_payment", "tags": ["financial"]}
{"id": "hb-06", "contract": "harbor_software_subscription.txt", "question": "Can the supplier raise the price, and by how much?", "reference_answer": "Yes, at each anniversary by up to five percent (5%) on 60 days' written notice.", "reference_quote": "by up to five percent (5%) on sixty (60) days' written notice", "term": "price_changes", "tags": ["financial"]}
{"id": "hb-07", "contract": "harbor_software_subscription.txt", "question": "What does it cost to terminate early?", "reference_answer": "An early termination charge equal to three months of the Annual Fee, pro rata, and no refund of prepaid fees; termination for convenience needs 60 days' notice.", "reference_quote": "early termination charge equal to three (3) months of the Annual Fee", "term": "termination_cost", "tags": ["financial", "term"]}
{"id": "hb-08", "contract": "harbor_software_subscription.txt", "question": "Does the agreement renew automatically?", "reference_answer": "No. It runs for 24 months and does not renew automatically; an extension needs a written renewal order signed by both parties.", "reference_quote": "It does not renew automatically", "term": "renewal", "tags": ["term"]}
{"id": "hb-09", "contract": "harbor_software_subscription.txt", "question": "How long is the term?", "reference_answer": "Twenty-four (24) months from the Effective Date.", "reference_quote": "continues for twenty-four (24) months", "term": "initial_term", "tags": ["term"]}
{"id": "hb-10", "contract": "harbor_software_subscription.txt", "question": "Is the customer's liability capped?", "reference_answer": "Not for IP infringement or confidentiality breaches: Customer's liability for those is unlimited. Supplier's liability is capped at the fees paid in the contract year.", "reference_quote": "Customer's liability for infringement of Supplier's intellectual property rights or breach of Section 5 is not limited", "tags": ["liability"]}
{"id": "hb-11", "contract": "harbor_software_subscription.txt", "question": "Which country's courts have jurisdiction?", "reference_answer": "The courts of Dublin, Ireland, have exclusive jurisdiction; Irish law governs.", "reference_quote": "The courts of Dublin have exclusive jurisdiction", "tags": ["term"]}
{"id": "hb-13", "contract": "harbor_software_subscription.txt", "question": "What is the effective date of the agreement?", "reference_answer": "15 April 2026, the date the agreement is made.", "reference_quote": "made on 15 April 2026", "term": "effective_date", "tags": ["term"]}
