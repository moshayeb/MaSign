APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql://rag_user:rag_password@localhost:5433/contract_rag
VECTOR_STORE_URL=http://localhost:6333
QDRANT_COLLECTION=contract_chunks

# Local CPU embedding model (sentence-transformers). See CLAUDE.md for the
# choice; swap to Qwen/Qwen3-Embedding-0.6B for higher quality if you have GPU
# inference. Changing any of these rebuilds the vector index (re-embedding the
# stored chunks) on the next start.
EMBEDDING_MODEL=freelawproject/modernbert-embed-base_finetune_512
EMBEDDING_MAX_TOKENS=512
# Input prefix scheme, normally derived from the model name: "nomic"
# (search_document: / search_query:, used by ModernBERT-embed models) or "none".
# EMBEDDING_PROMPT_FORMAT=nomic

# LLM for grounded answers (Sprint 2, MAS-13) — not used yet.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
