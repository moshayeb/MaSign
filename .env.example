APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql://rag_user:rag_password@localhost:5433/contract_rag
VECTOR_STORE_URL=http://localhost:6333
QDRANT_COLLECTION=contract_chunks

# Embeddings. Two profiles (CLAUDE.md, MAS-58): "portable" runs the model
# in-process with sentence-transformers (default, ModernBERT, CPU or GPU);
# "quality" calls an OpenAI-compatible server such as llama-server hosting
# Qwen3-Embedding-4B on a GPU (docker-compose.quality.yml). Changing any of
# these rebuilds the vector index (re-embedding the stored chunks) on the
# next start.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=freelawproject/modernbert-embed-base_finetune_512
EMBEDDING_MAX_TOKENS=512
# sentence-transformers only: auto (GPU when torch can see one, else CPU), cpu, cuda.
EMBEDDING_DEVICE=auto
# openai-compatible only: the server's base URL (it must offer /v1/embeddings).
# Token counts must be exact: llama-server's /tokenize is used when present;
# for a server without it, name the model's Hugging Face tokenizer instead.
# EMBEDDING_API_URL=http://localhost:8081
# EMBEDDING_API_KEY=
# EMBEDDING_TOKENIZER=Qwen/Qwen3-Embedding-4B
# Input prefix scheme, normally derived from the model name: "nomic"
# (search_document: / search_query:, ModernBERT-embed models), "qwen3"
# (query instruction, Qwen3-Embedding models) or "none".
# EMBEDDING_PROMPT_FORMAT=nomic

# LLM for grounded answers (Sprint 2, MAS-13) — not used yet.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
